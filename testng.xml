<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Classes run in parallel; each thread gets its own WebDriver via ThreadLocal. -->
<suite name="Demo Shop Regression" parallel="classes" thread-count="3">
  <listeners>
    <listener class-name="com.sdubbaka.qa.utils.ScreenshotOnFailureListener"/>
  </listeners>
  <test name="API">
    <packages><package name="com.sdubbaka.qa.tests.api"/></packages>
  </test>
  <test name="UI">
    <packages><package name="com.sdubbaka.qa.tests.ui"/></packages>
  </test>
</suite>
